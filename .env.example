# === Cross-Team Experiment Endpoint Configuration ===
#
# Option A: official OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Option B: your own Lambda/vLLM instance (gpt-oss-20b on port 8000)
# Each collaborator uses their OWN Lambda Cloud credits.
# DO NOT share or reuse another collaborator's endpoint URL.
# See docs/experiment_setup.md for one-time setup instructions.
OPENAI_BASE_URL=http://<your-lambda-instance-ip>:8000/v1

# vLLM usually does not validate this; "anything" is fine.
OPENAI_API_KEY=anything

# Optional debug
# AGENTBEATS_DEBUG=true
