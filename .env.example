# === Cross-Team Experiment Endpoint Configuration ===
#
# Option A: official OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Option B: your own Lambda/vLLM instance (gpt-oss-20b on port 8000)
# Each collaborator uses their OWN Lambda Cloud credits.
# DO NOT share or reuse another collaborator's endpoint URL.
# See docs/experiment_setup.md for one-time setup instructions.
OPENAI_BASE_URL=http://<your-lambda-instance-ip>:8000/v1

# vLLM usually does not validate this; "anything" is fine.
OPENAI_API_KEY=anything

# Optional per-role provider overrides.
# Leave these unset when all roles use OPENAI_BASE_URL/OPENAI_API_KEY.
#
# Example: OpenRouter attacker with OpenAI defender/normal user:
# ATTACKER_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ATTACKER_OPENAI_API_KEY=sk-or-...
# DEFENDER_OPENAI_BASE_URL=https://api.openai.com/v1
# DEFENDER_OPENAI_API_KEY=sk-...
# NORMAL_USER_OPENAI_BASE_URL=https://api.openai.com/v1
# NORMAL_USER_OPENAI_API_KEY=sk-...
#
# If all roles use OpenRouter, set OPENAI_BASE_URL/OPENAI_API_KEY to
# OpenRouter above and leave these role-specific overrides unset.

# Optional debug
# AGENTBEATS_DEBUG=true
