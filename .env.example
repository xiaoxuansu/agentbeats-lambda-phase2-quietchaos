# === Quiet Chaos · Cross-Team Experiment Endpoint Configuration ===
#
# Each team member uses their OWN Lambda Cloud credits.
# DO NOT share or reuse another member's endpoint URL.
# See docs/lambda_setup.md for one-time setup instructions.

# Point this to YOUR own Lambda vLLM instance (gpt-oss-20b on port 8000)
OPENAI_BASE_URL=http://<your-lambda-instance-ip>:8000/v1

# vLLM does not validate this; "anything" is fine.
OPENAI_API_KEY=anything

# Optional debug
# AGENTBEATS_DEBUG=true
